# ==============================================================================
# VARIABLES DE ENTORNO - SAAS DE TURNOS & CONTROL DE CAJA
# Copiar este archivo a .env para desarrollo local (nunca subir .env a Git)
# ==============================================================================

# --- Base de Datos (PostgreSQL / Supabase Pooler) ---
POSTGRES_DB=turnos_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev
POSTGRES_PORT=5432

# En producción (Render + Supabase), usar el puerto 6543 con sslmode=require&prepareThreshold=0
DATABASE_URL=jdbc:postgresql://localhost:5432/turnos_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_local_dev
HIKARI_MAX_POOL_SIZE=10

# --- Seguridad y CORS ---
FRONTEND_URL=http://localhost:5173

# --- Mercado Pago (Checkout Pro & Webhooks) ---
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_WEBHOOK_SECRET=tu_clave_secreta_webhook_hmac_sha256
MP_NOTIFICATION_URL=https://tu-dominio-backend.onrender.com/api/v1/pagos/mercadopago/webhook

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8080/api/v1

